rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app signs in anonymously (see firebaseClient.js), so every request
    // from the app carries an auth session. Admin vs player is enforced in the
    // client (the app's own OTP login), so these rules only gate on having a
    // signed-in session rather than per-document ownership.
    function signedIn() { return request.auth != null; }

    // Players: public read; any signed-in session may write.
    match /players/{playerId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Tournaments: public read (scoreboard/standings are public); signed-in write.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Tournament snapshots/history: signed-in read and write.
    match /tournament_snapshots/{snapshotId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Predictions: signed-in read and write.
    match /predictions/{predictionId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Public member cards contain only a display name and projected winner
    // and runner-up; mobile numbers and game-by-game picks remain private.
    match /team_prediction_summaries/{summaryId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Team fixture-level totals contain no member identity or individual picks.
    match /team_prediction_aggregates/{aggregateId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Match results for the static SMASHPICKS pages: scores per fixture, no identities.
    match /team_prediction_results/{tournamentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Prediction leaderboards hold display names and correct-pick counts only.
    match /team_prediction_leaderboards/{tournamentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Skill suggestions: public read; signed-in write.
    match /skill_suggestions/{suggId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Default: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
